
# Read by devServer.js via dotenv. env.json is a separate file with similar but
# differently-named keys; devServer.js does not read it, so editing it has no
# effect on the proxy.
DEV_SERVER_PROTOCOL=http
DEV_SERVER_HOSTNAME=localhost
# The port `npm start` serves on. devServer.js forges this as the Host header,
# and GeoNode builds the OIDC redirect_uri from it, so it has to be the real
# port and has to be registered as a valid redirect URI in Keycloak.
DEV_SERVER_PORT=8081
DEV_TARGET_GEONODE_HOST=localhost:8000
DEV_TARGET_UPLOAD_TOOL_HOST=localhost:8001
